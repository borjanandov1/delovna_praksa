# Copy to .env and fill in. .env is gitignored; this file is committed.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

DEBUG=True
SECRET_KEY=replace-me

# Comma separated. In production use the real FCSE hostname.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Production only ------------------------------------------------------
# Set to False if FCSE serves the site over plain HTTP, otherwise
# SECURE_SSL_REDIRECT causes an infinite redirect loop.
HTTPS_ENABLED=True

CONTACT_NOTIFY_EMAIL=info@forgefitness.mk
DEFAULT_FROM_EMAIL=noreply@forgefitness.mk

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
